# ─── Server Configuration ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=timesheet_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
# You can provide multiple comma-separated URLs (e.g., http://localhost:5173,https://your-username.github.io)
CLIENT_URL=http://localhost:5173,https://blesson-eglobe.github.io

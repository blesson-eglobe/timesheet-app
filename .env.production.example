# Production Environment Configuration Example
# When building for production (e.g., GitHub Pages), copy this to .env.production or set VITE_API_URL in your CI/CD (GitHub Actions / Netlify / Vercel secrets).

# Replace the URL below with the public URL of your deployed Express backend (e.g., on Render, Railway, or Fly.io)
VITE_API_URL=https://your-backend-service.onrender.com/api
